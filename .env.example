# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
PORT=8080
DB_USER=postgres
DB_PASSWORD=change-me
DB_IP=127.0.0.1
DB_PORT=5432
DB_NAME=fpanalytics
# Only used by the Makefile / dc-db.yml
DB_CONTAINER_NAME=analytics-db
# Key the launcher uses to open a session
ACCESS_KEY=change-me-access-key
# Key for the /data/* read endpoints
READ_KEY=change-me-read-key
